# ==============================================================================
# 🔐 NYX9 STUDIO PRODUCTION CONFIGURATION (.env)
# ==============================================================================

# 🐘 1. SUPABASE POSTGRESQL (DATABASE & REALTIME ENGINE)
# Connection String สำหรับรัน migration ผ่าน node database/deploy.js
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Supabase API Credentials (Project Settings -> API)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_public_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_private_key"

# 💬 2. DISCORD WEBHOOKS
# Discord Webhook สำหรับแจ้งเตือนออเดอร์ใหม่เข้าเซิร์ฟเวอร์
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"

# 💳 3. PAYMENT GATEWAY APIS
# PromptPay Slip Verification API (เช่น OpenSlipVerify / EasySlip)
SLIP_VERIFY_API_KEY="your_slip_verify_api_key_here"

# เบอร์ TrueMoney Wallet สำหรับรับยอดโอนจากซองของขวัญอัตโนมัติ
TRUEMONEY_PHONE="095xxxxxxx"

# Litecoin Native Public Address
LTC_PUBLIC_ADDRESS="ltc1q9x4n2s7j8m4zfk9pq98wv7wuxc3v5v2k4h5nqz"

# 🛡️ 4. SECURITY & ADMIN MASTER KEYS
# กุญแจหลักสำหรับเข้ารหัส AES-256 ข้อมูลสต็อก (Credentials Vault)
AES_VAULT_MASTER_KEY="generate_32_byte_hex_or_passphrase_here"

# รหัสผ่านสำหรับเข้าถึง Admin / Webhook Secret
ADMIN_SECRET_KEY="nyx9_secure_admin_passphrase"
